# ==============================================================================
# Bhai App - Environment Configuration Template
# ==============================================================================

# Database Settings (PostgreSQL + PostGIS)
POSTGRES_DB=bhai
POSTGRES_USER=bhai_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+asyncpg://bhai_user:replace-with-a-strong-database-password@localhost:5432/bhai

# Security & Authentication (Generate 32+ character secrets)
JWT_SECRET=replace-with-at-least-32-random-characters-for-jwt-signing
OTP_HMAC_SECRET=replace-with-a-second-at-least-32-random-secret-for-otp

# Dedicated Admin Dashboard Credentials
ADMIN_EMAIL=admin@bhai.app
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Deployment & Policy Configuration
ENVIRONMENT=production
CORS_ORIGINS=https://app.bhai.org,https://admin.bhai.org,http://localhost:3000
TRUSTED_PROXIES=127.0.0.1,::1
EMERGENCY_RADIUS_METERS=2000
EMERGENCY_NUMBER=112
LOCATION_RETENTION_DAYS=90

# Live Location Streaming Configuration
LIVE_LOCATION_INTERVAL_SECONDS=5
LIVE_LOCATION_SESSION_TIMEOUT_MINUTES=60

# APK Release Metadata & Direct Download Configuration
APK_VERSION=1.2.0
APK_SIZE_MB=49.8
APK_FILE_PATH=./bhai_app.apk
APK_DOWNLOAD_URL=/download/bhai_app.apk

# Development Helpers (Leave empty in production)
DEV_OTP_CODE=000000

# Push Notifications & SMS (Optional for local dev, required for prod SMS delivery)
FIREBASE_CREDENTIALS_PATH=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
