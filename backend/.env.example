# Required in every environment. Generate with a password manager; do not commit .env.
POSTGRES_DB=bhai
POSTGRES_USER=bhai
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://bhai:replace-with-a-long-random-password@localhost:5432/bhai
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_HMAC_SECRET=replace-with-a-second-at-least-32-random-secret

# Deployment policy
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
EMERGENCY_RADIUS_METERS=2000
EMERGENCY_NUMBER=112
LOCATION_RETENTION_DAYS=90

# Development only. Do not set in production; real OTP delivery is otherwise required.
DEV_OTP_CODE=000000

# FCM is optional during local development. Notifications are recorded but stay PENDING_CONFIGURATION
# until Firebase has been configured. Twilio is required for OTP delivery in production.
FIREBASE_CREDENTIALS_PATH=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
